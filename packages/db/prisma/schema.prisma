generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYSTEM_ADMIN
  TENANT_ADMIN
  LOAN_OFFICER
  ACCOUNTANT
  MEMBER
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  REPAID
  DEFAULTED
  REJECTED
}

model Tenant {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique // Short code for IDs
  rcNumber    String?  @unique
  settings    Json?
  
  users       User[]   // Users assigned to this tenant
  members     Member[]
  loans       Loan[]
  contributions Contribution[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  ninHash       String?   @unique // Institutional security: HMAC-SHA256
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  
  globalRole    Role      @default(MEMBER)
  
  tenants       Tenant[]  // Multi-tenancy support
  memberProfile Member?   // If they are also a member of a cooperative
  
  auditLogs     AuditLog[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Member {
  id           String       @id @default(uuid())
  memberCode   String       @unique // e.g., FGC-COOP-001
  status       MemberStatus @default(ACTIVE)
  
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id])
  
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  
  contributions Contribution[]
  loans         Loan[]
  
  joinedAt     DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId])
  @@index([memberCode])
}

model Contribution {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(15, 2)
  type        String   // SAVINGS, SPECIAL_DEPOSIT, etc.
  description String?
  
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([memberId])
  @@index([tenantId])
}

model Loan {
  id              String     @id @default(uuid())
  principal       Decimal    @db.Decimal(15, 2)
  interestRate    Decimal    @db.Decimal(5, 2)
  termMonths      Int
  status          LoanStatus @default(PENDING)
  
  memberId        String
  member          Member     @relation(fields: [memberId], references: [id])
  
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  
  approvedById    String?
  
  repaymentStart  DateTime?
  repaymentEnd    DateTime?
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([memberId])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // CREATE_LOAN, APPROVE_MEMBER, etc.
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  targetId  String?
  metadata  Json?
  ipAddress String?
  
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}
